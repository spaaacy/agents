{
    "display_information": {
        "name": "Aakif's Dot",
        "description": "Answers Aakif's Slack requests with the coding agent running on his Mac (Codex or Claude). Never edits code, tickets or anything else.",
        "background_color": "#D97757"
    },
    "features": {
        "app_home": {
            "home_tab_enabled": true,
            "messages_tab_enabled": true,
            "messages_tab_read_only_enabled": false,
            "agent_tasks_enabled": true
        },
        "bot_user": {
            "display_name": "Aakif's Dot",
            "always_online": false
        }
    },
    "oauth_config": {
        "scopes": {
            "user": [
                "im:history",
                "mpim:history",
                "chat:write",
                "reactions:write"
            ],
            "bot": [
                "app_mentions:read",
                "chat:write",
                "reactions:write",
                "channels:history",
                "groups:history",
                "im:history",
                "mpim:history",
                "users:read",
                "im:write"
            ]
        },
        "pkce_enabled": false
    },
    "settings": {
        "event_subscriptions": {
            "user_events": [
                "message.im",
                "message.mpim"
            ],
            "bot_events": [
                "app_home_opened",
                "app_mention",
                "message.im"
            ]
        },
        "interactivity": {
            "is_enabled": true
        },
        "org_deploy_enabled": false,
        "socket_mode_enabled": true,
        "is_mcp_enabled": false,
        "token_rotation_enabled": false,
        "app_level_token_rotation_enabled": false
    }
}
