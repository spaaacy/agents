{
    "display_information": {
        "name": "Aakif's Dot",
        "description": "Answers Aakif's Slack requests with the coding agent running on his Mac (Codex or Claude). Changes code or tickets only when he taps a button.",
        "background_color": "#D97757"
    },
    "features": {
        "app_home": {
            "home_tab_enabled": true,
            "messages_tab_enabled": true,
            "messages_tab_read_only_enabled": false,
            "agent_tasks_enabled": true
        },
        "agent_view": {
            "agent_description": "Aakif's agent on his Mac (Codex or Claude): answers questions about Envoy's code, PRs, Linear, Datadog and the read-only database, and runs actions only when he taps a button.",
            "suggested_prompts": [
                {
                    "title": "What's on fire?",
                    "message": "what's firing in datadog right now, and does any of it need me?"
                },
                {
                    "title": "My open PRs",
                    "message": "what's the state of my open PRs: CI, reviews, anything blocking?"
                },
                {
                    "title": "What shipped?",
                    "message": "what shipped to production today?"
                },
                {
                    "title": "Hub status",
                    "message": "!status"
                }
            ]
        },
        "bot_user": {
            "display_name": "Aakif's Dot",
            "always_online": false
        }
    },
    "oauth_config": {
        "scopes": {
            "user": [
                "im:history",
                "mpim:history",
                "chat:write",
                "reactions:write",
                "files:read"
            ],
            "bot": [
                "app_mentions:read",
                "chat:write",
                "reactions:write",
                "channels:history",
                "groups:history",
                "im:history",
                "mpim:history",
                "users:read",
                "im:write",
                "assistant:write",
                "files:read"
            ]
        },
        "pkce_enabled": false
    },
    "settings": {
        "event_subscriptions": {
            "user_events": [
                "message.im",
                "message.mpim"
            ],
            "bot_events": [
                "agent_session_stopped",
                "app_home_opened",
                "app_mention",
                "message.channels",
                "message.groups",
                "message.im"
            ]
        },
        "interactivity": {
            "is_enabled": true
        },
        "org_deploy_enabled": false,
        "socket_mode_enabled": true,
        "is_mcp_enabled": false,
        "token_rotation_enabled": false,
        "app_level_token_rotation_enabled": false
    }
}
