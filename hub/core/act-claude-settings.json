{
  "permissions": {
    "defaultMode": "dontAsk",
    "deny": [
      "Bash(gh pr merge *)",
      "Bash(gh pr review *)",
      "Bash(gh pr close *)",
      "Bash(gh api *)",
      "Bash(gh repo *)",
      "Bash(gh release *)",
      "Bash(gh secret *)",
      "Bash(gh workflow *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push --delete *)",
      "Bash(git push -d *)",
      "Bash(git -C * push --force *)",
      "Bash(git -C * push -f *)",
      "Bash(git -C * push --force-with-lease *)",
      "Bash(git -C * push --delete *)",
      "Bash(git stash *)",
      "Bash(git -C * stash *)",
      "Bash(git reset *)",
      "Bash(git -C * reset *)",
      "Bash(git clean *)",
      "Bash(git -C * clean *)",
      "Bash(az *)",
      "Bash(sudo *)",
      "Bash(launchctl *)",
      "mcp__claude_ai_Slack",
      "mcp__claude_ai_Claude_Docs",
      "mcp__agent-bus"
    ]
  },
  "enabledPlugins": {
    "datadog@claude-plugins-official": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.agents/hooks/docker-guard.py",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
