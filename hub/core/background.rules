# Unattended Codex runs (slack-claude, on-call-runner, slack-pr-review) load only this file.
# Files are read-only in those runs but the network is on, so what is refused here is what
# would write somewhere else: GitHub, Linear's CLI, Azure, another machine.

prefix_rule(pattern=["git", ["push", "commit", "reset", "checkout", "switch", "stash", "rebase", "merge", "cherry-pick", "revert", "tag", "am", "clean", "restore"]], decision="forbidden", justification="This run is read-only; say what should be done instead.", match=["git push origin HEAD"], not_match=["git log -1", "git diff origin/development"])
prefix_rule(pattern=["git", "-C", ["~/dev/envoyai-backend", "~/dev/envoyai-web", "~/dev/envoyai-chrome-plugin", "~/dev/envoyai-chat-ui", "~/dev/ci-workflows", "~/.agents", "/Users/aakifmohamed/dev/envoyai-backend", "/Users/aakifmohamed/dev/envoyai-web", "/Users/aakifmohamed/dev/envoyai-chrome-plugin", "/Users/aakifmohamed/dev/envoyai-chat-ui", "/Users/aakifmohamed/dev/ci-workflows", "/Users/aakifmohamed/.agents", "."], ["push", "commit", "reset", "checkout", "switch", "stash", "rebase", "merge", "cherry-pick", "revert", "tag", "am", "clean", "restore"]], decision="forbidden", justification="This run is read-only; say what should be done instead.", match=["git -C /Users/aakifmohamed/dev/envoyai-web push"])
prefix_rule(pattern=["gh", ["api", "auth", "release", "repo", "workflow", "secret", "variable", "label", "gist", "ssh-key", "gpg-key", "config", "extension", "codespace", "cache", "ruleset", "project", "alias", "attestation"]], decision="forbidden", justification="This run is read-only and may use only gh pr, issue, run and search reads.", match=["gh api user", "gh api graphql -f query=x"], not_match=["gh pr view 1"])
prefix_rule(pattern=["gh", "pr", ["create", "merge", "comment", "review", "edit", "close", "reopen", "ready", "lock", "unlock", "update-branch", "revert", "checkout"]], decision="forbidden", justification="This run is read-only; say what should be done instead.", match=["gh pr comment 1 -b hi"], not_match=["gh pr diff 1"])
prefix_rule(pattern=["gh", "issue", ["create", "comment", "edit", "close", "reopen", "delete", "transfer", "lock", "unlock", "pin", "unpin", "develop"]], decision="forbidden", justification="This run is read-only; say what should be done instead.", match=["gh issue comment 1 -b hi"], not_match=["gh issue view 1"])
prefix_rule(pattern=["gh", "run", ["rerun", "cancel", "delete", "download"]], decision="forbidden", justification="This run is read-only; say what should be done instead.", match=["gh run rerun 1"], not_match=["gh run view 1"])
prefix_rule(pattern=[["az", "ssh", "scp", "rsync", "sftp", "linear", "launchctl", "osascript", "security"]], decision="forbidden", justification="Not available to an unattended read-only run.", match=["az account show"])
