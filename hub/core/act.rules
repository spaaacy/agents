# Runs Aakif approved with a button (the hub's "act" mode) load only this file. They may edit in worktrees,
# commit, push and open PRs, and write Linear tickets; these stay off whatever the run was asked to do.

prefix_rule(pattern=["gh", "pr", ["merge", "review", "close", "lock"]], decision="forbidden", justification="Merging, approving and closing are Aakif's own clicks.", match=["gh pr merge 1"], not_match=["gh pr create --draft"])
prefix_rule(pattern=["gh", ["api", "auth", "release", "repo", "secret", "variable", "workflow", "ruleset", "ssh-key", "gpg-key", "config", "extension", "codespace", "cache"]], decision="forbidden", justification="Not part of an approved action.", match=["gh api user"])
prefix_rule(pattern=["gh", "issue", ["delete", "transfer", "lock"]], decision="forbidden", justification="Not part of an approved action.", match=["gh issue delete 1"])
prefix_rule(pattern=["git", "push", ["--force", "-f", "--force-with-lease", "--delete", "-d", "--mirror"]], decision="forbidden", justification="Never rewrite or delete a remote branch from an approved action.", match=["git push --force origin x"], not_match=["git push origin x"])
prefix_rule(pattern=["git", "-C", ["~/dev/envoyai-backend", "~/dev/envoyai-web", "~/dev/envoyai-chrome-plugin", "~/dev/envoyai-chat-ui", "~/dev/ci-workflows", "~/.agents", "/Users/aakifmohamed/dev/envoyai-backend", "/Users/aakifmohamed/dev/envoyai-web", "/Users/aakifmohamed/dev/envoyai-chrome-plugin", "/Users/aakifmohamed/dev/envoyai-chat-ui", "/Users/aakifmohamed/dev/ci-workflows", "/Users/aakifmohamed/.agents", "."], "push", ["--force", "-f", "--force-with-lease", "--delete", "-d", "--mirror"]], decision="forbidden", justification="Never rewrite or delete a remote branch from an approved action.", match=["git -C . push --force origin x"])
prefix_rule(pattern=["git", ["stash", "clean", "reset"]], decision="forbidden", justification="Never discard work; AGENTS.md forbids git stash.", match=["git stash"], not_match=["git status"])
prefix_rule(pattern=["git", "-C", ["~/dev/envoyai-backend", "~/dev/envoyai-web", "~/dev/envoyai-chrome-plugin", "~/dev/envoyai-chat-ui", "~/dev/ci-workflows", "~/.agents", "/Users/aakifmohamed/dev/envoyai-backend", "/Users/aakifmohamed/dev/envoyai-web", "/Users/aakifmohamed/dev/envoyai-chrome-plugin", "/Users/aakifmohamed/dev/envoyai-chat-ui", "/Users/aakifmohamed/dev/ci-workflows", "/Users/aakifmohamed/.agents", "."], ["stash", "clean", "reset"]], decision="forbidden", justification="Never discard work.", match=["git -C . stash"])
prefix_rule(pattern=[["az", "launchctl", "osascript", "security", "sudo"]], decision="forbidden", justification="Not available to an approved action; az always needs Aakif in the conversation.", match=["az account show"])
prefix_rule(pattern=["git", ["push", "commit"], ["--no-verify", "-n"]], decision="forbidden", justification="Hooks guard approved actions (no force-push, the repo's own checks); never skip them.", match=["git push --no-verify origin x", "git commit -n -m x"])
