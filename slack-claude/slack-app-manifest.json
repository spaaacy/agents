{
  "display_information": {
    "name": "Claude (Aakif's laptop)",
    "description": "Answers Aakif's @mentions with Claude Code running on his Mac. Read-only: it never edits code, tickets or anything else.",
    "background_color": "#D97757"
  },
  "features": {
    "bot_user": {
      "display_name": "claude-aakif",
      "always_online": false
    },
    "app_home": {
      "home_tab_enabled": false,
      "messages_tab_enabled": true,
      "messages_tab_read_only_enabled": false
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "chat:write",
        "reactions:write",
        "channels:history",
        "groups:history",
        "im:history",
        "mpim:history",
        "users:read"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": ["app_mention", "message.im"]
    },
    "interactivity": {
      "is_enabled": false
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
